# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=crypto_pump_detector

# Public hostname for Caddy's TLS certificate (docker-compose), e.g. prices.trigger.fun
DOMAIN=

# Required in production: every endpoint except /health needs it
# (HTTP x-api-key header; WebSocket x-api-key header or ?key=).
API_KEY=

# Exchanges that build candles and run spike alerts. The others
# (bybit_futures, kucoin_futures, aster_futures, hyperliquid) only serve live
# prices, connected while someone watches a symbol.
CANDLE_EXCHANGES=binance_futures,gate_futures

# Webhook
WEBHOOK_TIMEOUT_SECONDS=10

# Webhook for 10% tier alerts (5% = DB only, 10% = DB + webhook)
WEBHOOK_URL=http://localhost:9000/alert
WEBHOOK_API_KEY=

# Application
LOG_LEVEL=INFO
